# Copie para deploy/.env.prod e preencha. NUNCA faça commit do .env.prod.

# Domínio público com HTTPS (ex.: bot.gollab.com.br), com registro A
# apontando para o IP do servidor.
APP_DOMAIN=bot.gollab.com.br
NEXTAUTH_URL=https://bot.gollab.com.br

# Gere com: openssl rand -base64 32   (e openssl rand -hex 32 para a chave)
NEXTAUTH_SECRET=
CRON_SECRET=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# Login por link mágico. Opção grátis: Gmail com "senha de app"
# (myaccount.google.com/apppasswords). O @ do usuário vira %40.
EMAIL_SERVER=smtps://SEU_EMAIL%40gmail.com:SENHA_DE_APP@smtp.gmail.com:465
EMAIL_FROM=GOL LAB <SEU_EMAIL@gmail.com>
# Só estes e-mails conseguem entrar no painel.
ALLOWED_EMAILS=SEU_EMAIL@gmail.com

# Meta (Instagram API com login do Instagram)
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# Trava de seguidor (opcional; estes são os padrões)
# FOLLOW_RECHECK_DELAYS_MS=20000,40000
# FOLLOW_GATE_COOLDOWN_MS=10000
# FOLLOW_CHECK_TIMEOUT_MS=8000
